# ===================================
# API Keys - Configure pelo menos uma
# ===================================

# ============ APIs GRATUITAS (RECOMENDADO) ============

# Groq API Key (GRATUITO - 30 RPM, 14.400 RPD)
# Obtenha em: https://console.groq.com/
GROQ_API_KEY=sua_chave_groq_aqui

# Google Gemini API Key (GRATUITO - 15 RPM, 1M tokens/mês)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_google_aqui

# ============ PUTER - ALTERNATIVA GRATUITA AO CHATGPT ============

# Puter Bridge URL (Substitui ChatGPT quando OPENAI_API_KEY não configurada)
# Requer servidor Node.js: cd puter-bridge && npm start
# Para usar Puter: comente ou remova OPENAI_API_KEY abaixo
PUTER_BRIDGE_URL=http://localhost:3000

# ============ APIs PAGAS ============

# Claude/Anthropic API Key (PAGO - OPCIONAL)
# Se vazio, o modo Claude usará Puter (GRATUITO) automaticamente!
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# OpenAI API Key (PAGO - OPCIONAL)
# Se vazio, o modo ChatGPT usará Puter (GRATUITO) automaticamente!
# OPENAI_API_KEY=sua_chave_openai_aqui

# ===================================
# Model Configuration
# ===================================

# Groq model (default: llama-3.3-70b-versatile)
# Opções: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini model (default: gemini-flash-latest)
# Opções: gemini-flash-latest (rápido), gemini-2.5-flash, gemini-2.5-pro (avançado)
GEMINI_MODEL_NAME=gemini-flash-latest

# Claude model
CLAUDE_MODEL_NAME=claude-3-5-sonnet

# OpenAI model (default: gpt-4o)
# Opções: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL_NAME=gpt-4o

# Puter model (default: gpt-5.4-nano)
# Opções: gpt-5.4-nano, gpt-5.3-chat, claude-sonnet-4, gemini-2.5-flash-lite
PUTER_MODEL_NAME=gpt-5.4-nano

# ===================================
# Analysis Configuration
# ===================================

MAX_LOGS_PER_ANALYSIS=1000
SAMPLING_THRESHOLD=100
